# LLM Configuration
# Set LLM_PROVIDER to 'grok' (default, xAI), 'gemini', 'ollama', or 'auto'
# (auto tries Grok first, then Gemini, then Ollama)
LLM_PROVIDER=grok

# xAI Grok (default provider)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest

# Google Gemini (fallback / optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local, optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minimax-m3:cloud

# RAG settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Processing
MAX_RETRY_ATTEMPTS=3
PERIOD_DURATION_MINUTES=40
DEFAULT_LANGUAGE=English

# Storage paths (relative to backend directory)
UPLOAD_DIR=./data/uploads
PACKAGES_DIR=./data/packages
CHROMA_PERSIST_DIR=./data/chroma
