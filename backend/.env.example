# LLM Configuration
# Set LLM_PROVIDER to 'auto' (tries Gemini first, falls back to Ollama),
# 'gemini' (Gemini only), or 'ollama' (local Ollama only)
LLM_PROVIDER=auto

# Google Gemini (required for Gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (required for Ollama provider — install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minimax-m3:cloud

# RAG settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Processing
MAX_RETRY_ATTEMPTS=3
PERIOD_DURATION_MINUTES=40
DEFAULT_LANGUAGE=English

# Storage paths (relative to backend directory)
UPLOAD_DIR=./data/uploads
PACKAGES_DIR=./data/packages
CHROMA_PERSIST_DIR=./data/chroma
