# LLM Configuration
# LLM_PROVIDER: 'groq' (default, Groq Cloud) | 'ollama' (local) | 'auto' (Groq first, Ollama fallback)
LLM_PROVIDER=groq

# Groq Cloud (primary provider) — get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local fallback — optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# RAG settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Processing
MAX_RETRY_ATTEMPTS=3
PERIOD_DURATION_MINUTES=40
DEFAULT_LANGUAGE=English

# Storage paths (relative to backend directory)
UPLOAD_DIR=./data/uploads
PACKAGES_DIR=./data/packages
CHROMA_PERSIST_DIR=./data/chroma
