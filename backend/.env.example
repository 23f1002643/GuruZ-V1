# LLM Configuration
# LLM_PROVIDER: 'nvidia' (default, NVIDIA NIM) | 'groq' (fallback) | 'auto' (NVIDIA first, Groq fallback)
LLM_PROVIDER=nvidia

# NVIDIA NIM (primary provider) — get your key at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Groq Cloud (fallback provider) — get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Processing
MAX_RETRY_ATTEMPTS=3
PERIOD_DURATION_MINUTES=40
DEFAULT_LANGUAGE=English

# Storage paths (relative to backend directory)
UPLOAD_DIR=./data/uploads
PACKAGES_DIR=./data/packages
CHROMA_PERSIST_DIR=./data/chroma
